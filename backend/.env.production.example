# Railway production environment template.

PORT=8080
ENV=production
APP_URL=https://reorderflow-production-2968.up.railway.app
FRONTEND_DIST=

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-plus-byte-random-secret
JWT_TTL_HOURS=24

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-password
MANAGER_EMAIL=manager@yourdomain.com
MANAGER_PASSWORD=replace-with-a-strong-password

# Supabase PostgreSQL. Use the session pooler on port 5432 for GORM prepared statements.
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=replace-with-database-password
SUPABASE_DB_NAME=postgres
SUPABASE_DB_SSLMODE=require

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_BUCKET_NAME=po-documents

# Optional Redis (Upstash). Enable TLS and leave REDIS_ADDR as host:port.
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_TLS=true

RATE_LIMIT_LOGIN=10
RATE_LIMIT_APPROVAL=30
RATE_LIMIT_API=120

# Railway terminates TLS at its edge. Trust the forwarding headers so rate limits use the client IP.
TRUSTED_PROXIES=0.0.0.0/0
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=5

ENABLE_CRON=true


EMAIL_PROVIDER=auto
RESEND_API_KEY=
RESEND_FROM=ReorderFlow <onboarding@resend.dev>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=replace-with-google-app-password

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
